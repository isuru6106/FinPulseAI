generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum AssetType {
  STOCK
  CRYPTO
  ETF
  COMMODITY
  GOVERNMENT_SECURITY
  FIXED_DEPOSIT
  MUTUAL_FUND
  REAL_ESTATE
  CASH_EQUIVALENT
  OTHER
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  DELISTED
}

enum CandleInterval {
  MINUTE_1
  MINUTE_5
  MINUTE_15
  MINUTE_30
  HOUR_1
  HOUR_4
  DAY_1
  WEEK_1
}

enum ValuationMethod {
  MARKET_PRICE
  MANUAL
  CONTRACTUAL
  APPRAISAL
  ESTIMATED
}

enum HoldingStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

// ==========================================
// USERS
// ==========================================

model User {
  id           String  @id @default(cuid())
  name         String?
  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watchlists Watchlist[]
  sessions   Session[]
  portfolios Portfolio[]

  @@index([createdAt])
}

// ==========================================
// AUTHENTICATION SESSIONS
// ==========================================

model Session {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ==========================================
// PORTFOLIOS
// ==========================================

model Portfolio {
  id           String  @id @default(cuid())
  userId       String
  name         String  @default("My Portfolio")
  description  String?
  baseCurrency String  @default("USD")
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings Holding[]

  @@index([userId])
}

// ==========================================
// EXCHANGES
// ==========================================

model Exchange {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  country  String?
  timezone String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings AssetListing[]
}

// ==========================================
// ASSETS
// Stocks, crypto and other investments
// ==========================================

model Asset {
  id           String      @id @default(cuid())
  canonicalKey String      @unique
  symbol       String
  name         String
  type         AssetType
  status       AssetStatus @default(ACTIVE)

  description String?
  logoUrl     String?
  currency    String  @default("USD")

  // External provider identifiers
  coingeckoId String? @unique

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings AssetListing[]
  quotes   MarketQuote[]
  candles  MarketCandle[]

  watchlistItems WatchlistItem[]
  holdings       Holding[]

  @@index([symbol])
  @@index([name])
  @@index([type, status])
}

// ==========================================
// ASSET LISTINGS
// Connects assets to exchanges
// ==========================================

model AssetListing {
  id          String  @id @default(cuid())
  assetId     String
  exchangeId  String
  symbol      String
  tradingPair String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@unique([exchangeId, symbol])
  @@index([assetId])
  @@index([exchangeId])
}

// ==========================================
// MARKET QUOTES
// Latest and historical quote snapshots
// ==========================================

model MarketQuote {
  id       String @id @default(cuid())
  assetId  String
  provider String

  price        Decimal  @db.Decimal(30, 12)
  change24h    Decimal? @db.Decimal(20, 8)
  changePct24h Decimal? @db.Decimal(12, 6)
  volume24h    Decimal? @db.Decimal(30, 8)
  marketCap    Decimal? @db.Decimal(30, 8)

  capturedAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, capturedAt])
  @@index([provider, capturedAt])
}

// ==========================================
// MARKET CANDLES
// Historical OHLCV market data
// ==========================================

model MarketCandle {
  id       String         @id @default(cuid())
  assetId  String
  provider String
  interval CandleInterval

  openTime  DateTime
  closeTime DateTime?

  open   Decimal @db.Decimal(30, 12)
  high   Decimal @db.Decimal(30, 12)
  low    Decimal @db.Decimal(30, 12)
  close  Decimal @db.Decimal(30, 12)
  volume Decimal @default(0) @db.Decimal(30, 8)

  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, provider, interval, openTime])
  @@index([assetId, interval, openTime])
}

// ==========================================
// PORTFOLIO HOLDINGS
// Manually recorded existing investments
// ==========================================

model Holding {
  id          String @id @default(cuid())
  portfolioId String
  assetId     String

  quantity        Decimal         @db.Decimal(30, 12)
  averageCost     Decimal?        @db.Decimal(30, 12)
  costCurrency    String?
  valuationMethod ValuationMethod @default(MANUAL)
  status          HoldingStatus   @default(ACTIVE)

  acquiredAt DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolio  Portfolio        @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset      Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  valuations AssetValuation[]

  @@index([portfolioId])
  @@index([assetId])
  @@index([portfolioId, status])
}

// ==========================================
// ASSET VALUATIONS
// Historical investment valuations
// ==========================================

model AssetValuation {
  id        String @id @default(cuid())
  holdingId String

  unitPrice  Decimal @db.Decimal(30, 12)
  totalValue Decimal @db.Decimal(30, 12)
  currency   String

  method   ValuationMethod
  source   String?
  valuedAt DateTime        @default(now())

  createdAt DateTime @default(now())

  holding Holding @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@index([holdingId, valuedAt])
}

// ==========================================
// WATCHLISTS
// ==========================================

model Watchlist {
  id     String @id @default(cuid())
  userId String
  name   String @default("My Watchlist")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@index([userId])
}

// ==========================================
// WATCHLIST ITEMS
// ==========================================

model WatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  assetId     String
  addedAt     DateTime @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, assetId])
  @@index([assetId])
}
